    if childAddedConn or not Model then return end
    childAddedConn = Model.ChildAdded:Connect(function(mon)
        task.defer(function()
            mon:WaitForChild("Humanoid", 5)
            mon:WaitForChild("Head", 5)
            if Name or Health then addESP(mon) end
        end)
    end)
end

local function stopListener()
    if childAddedConn then
        childAddedConn:Disconnect()
        childAddedConn = nil
    end
end

