local function stopFly()
	if flyConnection then flyConnection:Disconnect() flyConnection = nil end
	root = char:FindFirstChild("HumanoidRootPart")
	if root then
		if root:FindFirstChild("FlyVelocity") then root.FlyVelocity:Destroy() end
		if root:FindFirstChild("FlyGyro") then root.FlyGyro:Destroy() end
	end
end
local function startFly()
	root = char:WaitForChild("HumanoidRootPart")
	if not root then return end
	
	stopFly()

	local bv = Instance.new("BodyVelocity", root)
	bv.Name = "FlyVelocity"
	bv.MaxForce = Vector3.new(9e9,9e9,9e9)
	local bg = Instance.new("BodyGyro", root)
	bg.Name = "FlyGyro"
	bg.MaxTorque = Vector3.new(9e9,9e9,9e9)

	if IsMobile then
		local control = require(plr.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
		flyConnection = Runs.RenderStepped:Connect(function()
			if not FlyEnabled or not bv.Parent then return end
            local camera = workspace.CurrentCamera
			local dir = control:GetMoveVector()

            if dir.X > 0 then
				bv.Velocity = bv.Velocity + camera.CFrame.RightVector * (dir.X * ((FlySpeed * 50)))
			end
			if dir.X < 0 then
				bv.Velocity = bv.Velocity + camera.CFrame.RightVector * (dir.X * ((FlySpeed * 50)))
			end
			if dir.Z > 0 then
				bv.Velocity = bv.Velocity - camera.CFrame.LookVector * (dir.Z * ((FlySpeed * 50)))
			end
			if dir.Z < 0 then
				bv.Velocity = bv.Velocity - camera.CFrame.LookVector * (dir.Z * ((FlySpeed * 50)))
			end
			bg.CFrame = camera.CFrame
		end)
	else
		flyConnection = Runs.RenderStepped:Connect(function()
			if not FlyEnabled or not bv.Parent then return end
			local cam = workspace.CurrentCamera
			local dir = Vector3.new(0,0,0)
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
			bv.Velocity = dir * FlySpeed * 10
			bg.CFrame = cam.CFrame
		end)
	end
end

