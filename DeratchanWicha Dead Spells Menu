local espConns = {}
local childAddedConn

local Name = false
local Health = false

local function escapeRichText(text)
    return tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
end

local function toHex(color)
    return string.format("#%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
end

local function removeESP(mon)
    local record = espConns[mon]
    if record then
        for _, conn in pairs(record) do
            if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
        end
        espConns[mon] = nil
    end

    local head = mon:FindFirstChild("Head")
    local gui = head and head:FindFirstChild("MobESP")
    if gui then gui:Destroy() end
end

local function updateText(mon)
    local record = espConns[mon]
    if not record or not record.label then return end

    local lines = {}
    if Name then
        local head = mon:FindFirstChild("Head")
        local color = head and toHex(head.Color) or "#FFFFFF"
        table.insert(lines, string.format('<font color="%s">%s</font>', color, escapeRichText(mon.Name)))
    end
    if Health then
        table.insert(lines, string.format('<font color="#00FF00">%d</font>', math.floor(record.humanoid.Health + 0.5)))
    end
    record.label.Text = table.concat(lines, "\n")
end

local function addESP(mon)
    local monHum = mon:FindFirstChildOfClass("Humanoid")
    local head = mon:FindFirstChild("Head")
    if not monHum or not head or monHum.Health <= 0 then return end

    if not Name and not Health then
        removeESP(mon)
        return
    end

    local record = espConns[mon]
    if not record then
        local oldGui = head:FindFirstChild("MobESP")
        if oldGui then oldGui:Destroy() end

        local BillBoard = Instance.new("BillboardGui")
        local Text = Instance.new("TextLabel")

        BillBoard.Name = "MobESP"
        BillBoard.Parent = head
        BillBoard.AlwaysOnTop = true
        BillBoard.LightInfluence = 1
        BillBoard.Size = UDim2.new(0, 200, 0, 50)
        BillBoard.StudsOffset = Vector3.new(0, 2.5, 0)

        Text.Parent = BillBoard
        Text.BackgroundTransparency = 1
        Text.BorderSizePixel = 0
        Text.Size = UDim2.new(1, 0, 1, 0)
        Text.Font = Enum.Font.Merriweather
        Text.TextStrokeColor3 = Color3.new(0, 0, 0)
        Text.TextStrokeTransparency = 0
        Text.TextSize = 20
        Text.RichText = true

        record = { humanoid = monHum, label = Text }
        espConns[mon] = record
        record.died = monHum.Died:Connect(function()
            removeESP(mon)
        end)
        record.removed = mon.AncestryChanged:Connect(function(_, parent)
            if not parent then removeESP(mon) end
        end)
    end

    -- à¹à¸à¸·à¹à¸­à¸¡à¸à¹à¸­à¹à¸à¸à¸²à¸°à¹à¸¡à¸·à¹à¸­à¹à¸à¸´à¸ Health à¹à¸à¸·à¹à¸­à¸¥à¸à¸à¸²à¸£à¹à¸à¹à¸à¸£à¸±à¸à¸¢à¸²à¸à¸£
    if Health and not record.health then
        record.health = monHum.HealthChanged:Connect(function()
            updateText(mon)
        end)
    elseif not Health and record.health then
        record.health:Disconnect()
        record.health = nil
    end

    updateText(mon)
end

local function refreshAllESP()
    if not Model then return end
    for _, mon in ipairs(Model:GetChildren()) do
        if mon:FindFirstChildOfClass("Humanoid") then
            addESP(mon)
        end
    end
end

