local function weapon()
    for _, tool in ipairs(char:GetChildren()) do
        local cfg = tool:FindFirstChildOfClass("Configuration")
        local handle = tool:FindFirstChild("Handle")
        if cfg and cfg:GetAttribute("Damage")
            and cfg:GetAttribute("MeleeType") == "Short"
            and handle then
            return tool, cfg, handle
        end
    end

    for _, tool in ipairs(lpr.Backpack:GetChildren()) do
        local cfg = tool:FindFirstChildOfClass("Configuration")
        local handle = tool:FindFirstChild("Handle")
        if cfg and cfg:GetAttribute("Damage")
            and cfg:GetAttribute("MeleeType") == "Short"
            and handle then
            return tool, cfg, handle
        end
    end
end

